@model IReadOnlyList<Product>

<div class="ajax-result" data-product-count="@Model.Count">
    @if (Model.Count == 0)
    {
        <div class="empty-result"><span>⌕</span><strong>Không tìm thấy sản phẩm</strong><p>Hãy thử từ khóa hoặc danh mục khác.</p></div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    }
</div>
