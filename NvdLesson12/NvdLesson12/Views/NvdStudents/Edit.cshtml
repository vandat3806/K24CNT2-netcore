@model NvdStudentFormViewModel
@{ ViewData["Title"] = "Sửa sinh viên"; }
<div class="page-heading"><div><span class="eyebrow">Student #@Model.NvdStudentId</span><h1>Chỉnh sửa sinh viên</h1></div></div><form asp-action="Edit" asp-route-id="@Model.NvdStudentId" method="post" enctype="multipart/form-data" class="form-card"><input type="hidden" asp-for="NvdStudentId" /><partial name="_Form" model="Model" /><div class="button-row"><button class="btn btn-primary" type="submit">Cập nhật</button><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></form>
