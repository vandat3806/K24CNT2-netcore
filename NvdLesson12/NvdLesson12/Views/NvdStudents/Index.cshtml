@model IReadOnlyList<NvdStudent>
@{ ViewData["Title"] = "Quản lý sinh viên"; }
<div class="page-heading"><div><span class="eyebrow">Bài 5 & 6</span><h1>Quản lý sinh viên</h1><p>CRUD bảng Student, kiểm tra email/số điện thoại duy nhất.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm sinh viên</a></div>
<form method="get" class="toolbar"><label><span>Tìm kiếm</span><input type="search" name="search" value="@ViewBag.Search" placeholder="Họ tên, email, điện thoại..." /></label><label><span>Lớp</span><select name="classId" asp-items="ViewBag.Classes"><option value="">Tất cả lớp</option></select></label><button class="btn btn-primary" type="submit">Lọc</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a></form>
<div class="table-card"><table><thead><tr><th>Ảnh</th><th>Sinh viên</th><th>Liên hệ</th><th>Lớp</th><th>Ngày sinh</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td><img class="avatar" src="@(item.NvdStudentAvatar ?? "/images/avatar-student.svg")" alt="@item.NvdStudentName" /></td><td><strong>@item.NvdStudentName</strong><br /><small class="muted">ID: @item.NvdStudentId</small></td><td>@item.NvdStudentEmail<br /><small class="muted">@item.NvdStudentPhone</small></td><td><span class="chip">@item.NvdStdClass.NvdClassName</span></td><td>@item.NvdStudentBirthday.ToString("dd/MM/yyyy")</td><td class="actions"><a class="btn btn-small btn-outline" asp-action="Details" asp-route-id="@item.NvdStudentId">Xem</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.NvdStudentId">Sửa</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.NvdStudentId">Xóa</a></td></tr>
}
</tbody></table></div>
