@model NvdStudent
@{ ViewData["Title"] = "Xóa sinh viên"; }
<div class="page-heading"><div><span class="eyebrow">Xác nhận</span><h1>Xóa sinh viên</h1></div></div><section class="delete-card media-detail"><img class="avatar" style="width:180px;height:180px" src="@(Model.NvdStudentAvatar ?? "/images/avatar-student.svg")" alt="@Model.NvdStudentName" /><div><h2>@Model.NvdStudentName</h2><p>Lớp: <strong>@Model.NvdStdClass.NvdClassName</strong></p><p>Xóa sinh viên sẽ xóa luôn <strong>@Model.NvdMarks.Count</strong> bản ghi điểm và ảnh đã upload.</p><form asp-action="Delete" asp-route-id="@Model.NvdStudentId" method="post" class="button-row"><button class="btn btn-danger" type="submit">Xác nhận xóa</button><a class="btn btn-ghost" asp-action="Index">Hủy</a></form></div></section>
