@model NvdStudent
@{ ViewData["Title"] = "Chi tiết sinh viên"; }
<div class="page-heading"><div><span class="eyebrow">Student #@Model.NvdStudentId</span><h1>@Model.NvdStudentName</h1></div></div>
<section class="detail-card media-detail"><img class="avatar" style="width:220px;height:220px" src="@(Model.NvdStudentAvatar ?? "/images/avatar-student.svg")" alt="@Model.NvdStudentName" /><div><dl class="detail-grid"><div><dt>Email</dt><dd>@Model.NvdStudentEmail</dd></div><div><dt>Số điện thoại</dt><dd>@Model.NvdStudentPhone</dd></div><div><dt>Lớp</dt><dd>@Model.NvdStdClass.NvdClassName</dd></div><div><dt>Ngày sinh</dt><dd>@Model.NvdStudentBirthday.ToString("dd/MM/yyyy")</dd></div><div><dt>Địa chỉ</dt><dd>@Model.NvdStudentAddress</dd></div></dl><div class="button-row"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.NvdStudentId">Chỉnh sửa</a><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></div></section>
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">Marks</span><h2>Kết quả học tập</h2></div><a class="btn btn-outline" asp-controller="NvdMarks" asp-action="Create">+ Nhập điểm</a></div>@if (Model.NvdMarks.Count == 0) { <div class="empty-state"><p>Chưa có điểm.</p></div> } else { <div class="table-card"><table><thead><tr><th>Môn học</th><th>Điểm</th></tr></thead><tbody>@foreach (var mark in Model.NvdMarks.OrderBy(x => x.NvdSubject.NvdSubjectName)) { <tr><td>@mark.NvdSubject.NvdSubjectName</td><td class="score">@mark.NvdScore.ToString("0.##")</td></tr> }</tbody></table></div> }</section>
