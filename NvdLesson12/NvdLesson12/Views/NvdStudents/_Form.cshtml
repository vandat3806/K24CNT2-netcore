@model NvdStudentFormViewModel
<div asp-validation-summary="ModelOnly"></div><div class="form-grid">
    <div class="form-group full"><label asp-for="NvdStudentName"></label><input asp-for="NvdStudentName" /><span asp-validation-for="NvdStudentName"></span></div>
    <div class="form-group"><label asp-for="NvdStudentEmail"></label><input asp-for="NvdStudentEmail" type="email" /><span asp-validation-for="NvdStudentEmail"></span></div>
    <div class="form-group"><label asp-for="NvdStudentPhone"></label><input asp-for="NvdStudentPhone" type="tel" /><span asp-validation-for="NvdStudentPhone"></span></div>
    <div class="form-group"><label asp-for="NvdStudentBirthday"></label><input asp-for="NvdStudentBirthday" type="date" /><span asp-validation-for="NvdStudentBirthday"></span></div>
    <div class="form-group"><label asp-for="NvdStdClassId"></label><select asp-for="NvdStdClassId" asp-items="Model.NvdClasses"><option value="0">-- Chọn lớp --</option></select><span asp-validation-for="NvdStdClassId"></span></div>
    <div class="form-group full"><label asp-for="NvdStudentAddress"></label><input asp-for="NvdStudentAddress" /><span asp-validation-for="NvdStudentAddress"></span></div>
    <div class="form-group full"><label asp-for="NvdAvatarFile"></label><input asp-for="NvdAvatarFile" type="file" accept="image/jpeg,image/png,image/gif,image/webp" /><span asp-validation-for="NvdAvatarFile"></span><small class="muted">JPG, PNG, GIF hoặc WEBP; tối đa 2 MB.</small></div>
    @if (!string.IsNullOrWhiteSpace(Model.NvdCurrentAvatar)) { <div class="form-group full"><span class="field-label">Ảnh hiện tại</span><img class="avatar" src="@Model.NvdCurrentAvatar" alt="Ảnh đại diện hiện tại" /></div> }
</div>
