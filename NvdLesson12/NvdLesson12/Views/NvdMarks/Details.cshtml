@model NvdMark
@{ ViewData["Title"] = "Chi tiết điểm"; }
<div class="page-heading"><div><span class="eyebrow">Marks</span><h1>Chi tiết điểm</h1></div></div><section class="detail-card"><dl class="detail-grid"><div><dt>Sinh viên</dt><dd>@Model.NvdStudent.NvdStudentName</dd></div><div><dt>Lớp</dt><dd>@Model.NvdStudent.NvdStdClass.NvdClassName</dd></div><div><dt>Môn học</dt><dd>@Model.NvdSubject.NvdSubjectName</dd></div><div><dt>Điểm</dt><dd class="score">@Model.NvdScore.ToString("0.##") / 10</dd></div><div><dt>StudentId</dt><dd>@Model.NvdStudentId</dd></div><div><dt>SubjectId</dt><dd>@Model.NvdSubjectId</dd></div></dl><div class="button-row"><a class="btn btn-primary" asp-action="Edit" asp-route-studentId="@Model.NvdStudentId" asp-route-subjectId="@Model.NvdSubjectId">Chỉnh sửa</a><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></section>
