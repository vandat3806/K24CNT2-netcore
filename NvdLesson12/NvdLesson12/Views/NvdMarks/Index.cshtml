@model IReadOnlyList<NvdMark>
@{ ViewData["Title"] = "Quản lý bảng điểm"; }
<div class="page-heading"><div><span class="eyebrow">Bài 5 & 6</span><h1>Bảng điểm</h1><p>Khóa chính kép gồm SubjectId và StudentId.</p></div><a class="btn btn-primary" asp-action="Create">+ Nhập điểm</a></div>
<form method="get" class="toolbar"><label><span>Tìm sinh viên</span><input type="search" name="search" value="@ViewBag.Search" placeholder="Họ tên sinh viên..." /></label><label><span>Môn học</span><select name="subjectId" asp-items="ViewBag.Subjects"><option value="">Tất cả môn</option></select></label><button class="btn btn-primary" type="submit">Lọc</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a></form>
<div class="table-card"><table><thead><tr><th>Sinh viên</th><th>Lớp</th><th>Môn học</th><th>Điểm</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td><strong>@item.NvdStudent.NvdStudentName</strong></td><td>@item.NvdStudent.NvdStdClass.NvdClassName</td><td>@item.NvdSubject.NvdSubjectName</td><td class="score">@item.NvdScore.ToString("0.##")</td><td class="actions"><a class="btn btn-small btn-outline" asp-action="Details" asp-route-studentId="@item.NvdStudentId" asp-route-subjectId="@item.NvdSubjectId">Xem</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-studentId="@item.NvdStudentId" asp-route-subjectId="@item.NvdSubjectId">Sửa</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-studentId="@item.NvdStudentId" asp-route-subjectId="@item.NvdSubjectId">Xóa</a></td></tr>
}
</tbody></table></div>
