@model NvdMarkFormViewModel
@{ ViewData["Title"] = "Sửa điểm"; }
<div class="page-heading"><div><span class="eyebrow">Marks</span><h1>Chỉnh sửa điểm</h1><p>Không thay đổi hai cột khóa chính.</p></div></div><form asp-action="Edit" asp-route-studentId="@Model.NvdStudentId" asp-route-subjectId="@Model.NvdSubjectId" method="post" class="form-card"><input type="hidden" asp-for="NvdStudentId" /><input type="hidden" asp-for="NvdSubjectId" /><div asp-validation-summary="ModelOnly"></div><div class="form-grid"><div class="form-group"><label asp-for="NvdStudentId"></label><select asp-for="NvdStudentId" asp-items="Model.NvdStudents" disabled></select></div><div class="form-group"><label asp-for="NvdSubjectId"></label><select asp-for="NvdSubjectId" asp-items="Model.NvdSubjects" disabled></select></div><div class="form-group full"><label asp-for="NvdScore"></label><input asp-for="NvdScore" type="number" min="0" max="10" step="0.01" /><span asp-validation-for="NvdScore"></span></div></div><div class="button-row"><button class="btn btn-primary" type="submit">Cập nhật</button><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></form>
