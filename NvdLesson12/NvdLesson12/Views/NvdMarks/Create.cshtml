@model NvdMarkFormViewModel
@{ ViewData["Title"] = "Nhập điểm"; }
<div class="page-heading"><div><span class="eyebrow">Marks</span><h1>Nhập điểm</h1></div></div><form asp-action="Create" method="post" class="form-card"><div asp-validation-summary="ModelOnly"></div><div class="form-grid"><div class="form-group"><label asp-for="NvdStudentId"></label><select asp-for="NvdStudentId" asp-items="Model.NvdStudents"><option value="0">-- Chọn sinh viên --</option></select><span asp-validation-for="NvdStudentId"></span></div><div class="form-group"><label asp-for="NvdSubjectId"></label><select asp-for="NvdSubjectId" asp-items="Model.NvdSubjects"><option value="0">-- Chọn môn học --</option></select><span asp-validation-for="NvdSubjectId"></span></div><div class="form-group full"><label asp-for="NvdScore"></label><input asp-for="NvdScore" type="number" min="0" max="10" step="0.01" /><span asp-validation-for="NvdScore"></span></div></div><div class="button-row"><button class="btn btn-primary" type="submit">Lưu điểm</button><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></form>
