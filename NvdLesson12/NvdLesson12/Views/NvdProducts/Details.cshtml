@model NvdProduct
@{ ViewData["Title"] = "Chi tiết sản phẩm"; }
<div class="page-heading"><div><span class="eyebrow">Product #@Model.NvdProductId</span><h1>@Model.NvdName</h1></div></div>
<section class="detail-card media-detail"><img src="@(Model.NvdImage ?? "/images/image-placeholder.svg")" alt="@Model.NvdName" /><div><dl class="detail-grid"><div><dt>Danh mục</dt><dd>@Model.NvdCategory.NvdName</dd></div><div><dt>Trạng thái</dt><dd>@(Model.NvdStatus ? "Đang bán" : "Tạm ẩn")</dd></div><div><dt>Giá niêm yết</dt><dd>@Model.NvdPrice.ToString("N0") ₫</dd></div><div><dt>Giá khuyến mại</dt><dd>@Model.NvdSalePrice.ToString("N0") ₫</dd></div><div><dt>Ngày tạo</dt><dd>@Model.NvdCreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Mô tả</dt><dd>@(Model.NvdDescription ?? "Chưa có mô tả")</dd></div></dl><div class="button-row"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.NvdProductId">Chỉnh sửa</a><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></div></section>
