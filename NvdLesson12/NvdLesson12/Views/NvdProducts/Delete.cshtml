@model NvdProduct
@{ ViewData["Title"] = "Xóa sản phẩm"; }
<div class="page-heading"><div><span class="eyebrow">Xác nhận</span><h1>Xóa sản phẩm</h1></div></div><section class="delete-card media-detail"><img src="@(Model.NvdImage ?? "/images/image-placeholder.svg")" alt="@Model.NvdName" /><div><h2>@Model.NvdName</h2><p>Danh mục: <strong>@Model.NvdCategory.NvdName</strong></p><p>Ảnh đã upload (nếu có) cũng sẽ được xóa khỏi máy chủ.</p><form asp-action="Delete" asp-route-id="@Model.NvdProductId" method="post" class="button-row"><button class="btn btn-danger" type="submit">Xác nhận xóa</button><a class="btn btn-ghost" asp-action="Index">Hủy</a></form></div></section>
