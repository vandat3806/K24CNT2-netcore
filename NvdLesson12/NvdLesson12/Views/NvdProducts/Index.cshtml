@model IReadOnlyList<NvdProduct>
@{ ViewData["Title"] = "Quản lý sản phẩm"; }
<div class="page-heading"><div><span class="eyebrow">Bài 1</span><h1>Quản lý sản phẩm</h1><p>CRUD Product với upload ảnh và liên kết Category.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm sản phẩm</a></div>
<form method="get" class="toolbar">
    <label><span>Tìm kiếm</span><input type="search" name="search" value="@ViewBag.Search" placeholder="Tên sản phẩm..." /></label>
    <label><span>Danh mục</span><select name="categoryId" asp-items="ViewBag.Categories"><option value="">Tất cả</option></select></label>
    <label><span>Trạng thái</span><select name="status"><option value="">Tất cả</option><option value="true">Đang bán</option><option value="false">Tạm ẩn</option></select></label>
    <button class="btn btn-primary" type="submit">Lọc</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a>
</form>
<div class="table-card"><table><thead><tr><th>Ảnh</th><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr>
        <td><img class="table-image" src="@(item.NvdImage ?? "/images/image-placeholder.svg")" alt="@item.NvdName" /></td>
        <td><strong>@item.NvdName</strong><br /><small class="muted">@item.NvdCreatedDate.ToLocalTime().ToString("dd/MM/yyyy")</small></td>
        <td>@item.NvdCategory.NvdName</td>
        <td><strong>@item.NvdSalePrice.ToString("N0") ₫</strong><br /><del class="muted">@item.NvdPrice.ToString("N0") ₫</del></td>
        <td><span class="badge @(item.NvdStatus ? "badge-on" : "badge-off")">@(item.NvdStatus ? "Đang bán" : "Tạm ẩn")</span></td>
        <td class="actions"><a class="btn btn-small btn-outline" asp-action="Details" asp-route-id="@item.NvdProductId">Xem</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.NvdProductId">Sửa</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.NvdProductId">Xóa</a><form asp-action="ToggleStatus" asp-route-id="@item.NvdProductId" method="post"><button class="btn btn-small btn-ghost" type="submit">Đổi trạng thái</button></form></td>
    </tr>
}
</tbody></table></div>
