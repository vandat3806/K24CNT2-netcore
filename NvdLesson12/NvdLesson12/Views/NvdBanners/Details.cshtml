@model NvdBanner
@{ ViewData["Title"] = "Chi tiết banner"; }
<div class="page-heading"><div><span class="eyebrow">Banner #@Model.NvdBannerId</span><h1>@Model.NvdName</h1></div></div><section class="detail-card media-detail"><img src="@(Model.NvdImage ?? "/images/image-placeholder.svg")" alt="@Model.NvdName" /><div><dl class="detail-grid"><div><dt>Trạng thái</dt><dd>@(Model.NvdStatus ? "Đang hiển thị" : "Đang ẩn")</dd></div><div><dt>Ngày tạo</dt><dd>@Model.NvdCreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Mô tả</dt><dd>@(Model.NvdDescription ?? "Chưa có mô tả")</dd></div></dl><div class="button-row"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.NvdBannerId">Chỉnh sửa</a><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></div></section>
