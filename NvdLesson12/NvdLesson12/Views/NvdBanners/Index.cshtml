@model IReadOnlyList<NvdBanner>
@{ ViewData["Title"] = "Quản lý banner"; }
<div class="page-heading"><div><span class="eyebrow">Bài 3 & 4</span><h1>Quản lý banner</h1><p>CRUD Banner và hiển thị banner đang bật trên trang chủ.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm banner</a></div>
<form method="get" class="toolbar"><label><span>Tìm kiếm</span><input type="search" name="search" value="@ViewBag.Search" placeholder="Tên banner..." /></label><label><span>Trạng thái</span><select name="status"><option value="">Tất cả</option><option value="true">Đang hiển thị</option><option value="false">Đang ẩn</option></select></label><button class="btn btn-primary" type="submit">Lọc</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a></form>
<div class="table-card"><table><thead><tr><th>Ảnh</th><th>Banner</th><th>Ngày tạo</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td><img class="table-image" src="@(item.NvdImage ?? "/images/image-placeholder.svg")" alt="@item.NvdName" /></td><td><strong>@item.NvdName</strong><br /><small class="muted">@item.NvdDescription</small></td><td>@item.NvdCreatedDate.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="badge @(item.NvdStatus ? "badge-on" : "badge-off")">@(item.NvdStatus ? "Hiển thị" : "Đang ẩn")</span></td><td class="actions"><a class="btn btn-small btn-outline" asp-action="Details" asp-route-id="@item.NvdBannerId">Xem</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.NvdBannerId">Sửa</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.NvdBannerId">Xóa</a><form asp-action="ToggleStatus" asp-route-id="@item.NvdBannerId" method="post"><button class="btn btn-small btn-ghost" type="submit">Đổi trạng thái</button></form></td></tr>
}
</tbody></table></div>
