@model NvdStdClass
@{ ViewData["Title"] = "Xóa lớp học"; }
<div class="page-heading"><div><span class="eyebrow">Xác nhận</span><h1>Xóa lớp học</h1></div></div><section class="delete-card"><h2>@Model.NvdClassName</h2><p>Lớp đang có <strong>@Model.NvdStudents.Count</strong> sinh viên. Chỉ có thể xóa lớp trống.</p><form asp-action="Delete" asp-route-id="@Model.NvdStdClassId" method="post" class="button-row"><button class="btn btn-danger" type="submit">Xác nhận xóa</button><a class="btn btn-ghost" asp-action="Index">Hủy</a></form></section>
