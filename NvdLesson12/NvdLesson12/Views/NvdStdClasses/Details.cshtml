@model NvdStdClass
@{ ViewData["Title"] = "Chi tiết lớp học"; }
<div class="page-heading"><div><span class="eyebrow">StdClass #@Model.NvdStdClassId</span><h1>@Model.NvdClassName</h1></div></div><section class="detail-card"><h2>Danh sách sinh viên (@Model.NvdStudents.Count)</h2>@if (Model.NvdStudents.Count == 0) { <p>Chưa có sinh viên trong lớp.</p> } else { <div class="table-card"><table><thead><tr><th>Họ tên</th><th>Email</th></tr></thead><tbody>@foreach (var student in Model.NvdStudents.OrderBy(x => x.NvdStudentName)) { <tr><td>@student.NvdStudentName</td><td>@student.NvdStudentEmail</td></tr> }</tbody></table></div> }<div class="button-row"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.NvdStdClassId">Chỉnh sửa</a><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></section>
