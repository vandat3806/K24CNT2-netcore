@model IReadOnlyList<NvdStdClass>
@{ ViewData["Title"] = "Quản lý lớp học"; }
<div class="page-heading"><div><span class="eyebrow">StudentManager</span><h1>Lớp học</h1><p>CRUD bảng StdClass theo mô hình Code First.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm lớp</a></div>
<form method="get" class="toolbar"><label><span>Tìm kiếm</span><input type="search" name="search" value="@ViewBag.Search" placeholder="Tên lớp..." /></label><button class="btn btn-primary" type="submit">Tìm</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a></form>
<div class="table-card"><table><thead><tr><th>ID</th><th>Tên lớp</th><th>Số sinh viên</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.NvdStdClassId</td><td><strong>@item.NvdClassName</strong></td><td>@item.NvdStudents.Count</td><td class="actions"><a class="btn btn-small btn-outline" asp-action="Details" asp-route-id="@item.NvdStdClassId">Xem</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.NvdStdClassId">Sửa</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.NvdStdClassId">Xóa</a></td></tr>
}
</tbody></table></div>
