@model NvdSubject
@{ ViewData["Title"] = "Chi tiết môn học"; }
<div class="page-heading"><div><span class="eyebrow">Subjects #@Model.NvdSubjectId</span><h1>@Model.NvdSubjectName</h1></div></div><section class="detail-card"><h2>Kết quả (@Model.NvdMarks.Count)</h2>@if (Model.NvdMarks.Count == 0) { <p>Chưa có điểm cho môn học này.</p> } else { <div class="table-card"><table><thead><tr><th>Sinh viên</th><th>Điểm</th></tr></thead><tbody>@foreach (var mark in Model.NvdMarks.OrderByDescending(x => x.NvdScore)) { <tr><td>@mark.NvdStudent.NvdStudentName</td><td class="score">@mark.NvdScore.ToString("0.##")</td></tr> }</tbody></table></div> }<div class="button-row"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.NvdSubjectId">Chỉnh sửa</a><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></section>
