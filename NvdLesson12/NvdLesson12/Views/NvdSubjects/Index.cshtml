@model IReadOnlyList<NvdSubject>
@{ ViewData["Title"] = "Quản lý môn học"; }
<div class="page-heading"><div><span class="eyebrow">StudentManager</span><h1>Môn học</h1><p>Tên môn học được kiểm tra không trùng.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm môn học</a></div>
<form method="get" class="toolbar"><label><span>Tìm kiếm</span><input type="search" name="search" value="@ViewBag.Search" placeholder="Tên môn học..." /></label><button class="btn btn-primary" type="submit">Tìm</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a></form>
<div class="table-card"><table><thead><tr><th>ID</th><th>Tên môn học</th><th>Số điểm</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.NvdSubjectId</td><td><strong>@item.NvdSubjectName</strong></td><td>@item.NvdMarks.Count</td><td class="actions"><a class="btn btn-small btn-outline" asp-action="Details" asp-route-id="@item.NvdSubjectId">Xem</a><a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.NvdSubjectId">Sửa</a><a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.NvdSubjectId">Xóa</a></td></tr>
}
</tbody></table></div>
