@model NvdCategory
@{ ViewData["Title"] = "Sửa danh mục"; }
<div class="page-heading"><div><span class="eyebrow">Category</span><h1>Chỉnh sửa danh mục</h1></div></div>
<form asp-action="Edit" asp-route-id="@Model.NvdCategoryId" method="post" class="form-card"><input type="hidden" asp-for="NvdCategoryId" /><partial name="_Form" model="Model" /><div class="button-row"><button class="btn btn-primary" type="submit">Cập nhật</button><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></form>
