@model NvdCategory
@{ ViewData["Title"] = "Chi tiết danh mục"; }
<div class="page-heading"><div><span class="eyebrow">Category #@Model.NvdCategoryId</span><h1>@Model.NvdName</h1></div></div>
<section class="detail-card"><dl class="detail-grid"><div><dt>Trạng thái</dt><dd>@(Model.NvdStatus ? "Đang hiển thị" : "Đang ẩn")</dd></div><div><dt>Ngày tạo</dt><dd>@Model.NvdCreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Số sản phẩm</dt><dd>@Model.NvdProducts.Count</dd></div></dl><div class="button-row"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.NvdCategoryId">Chỉnh sửa</a><a class="btn btn-ghost" asp-action="Index">Quay lại</a></div></section>
