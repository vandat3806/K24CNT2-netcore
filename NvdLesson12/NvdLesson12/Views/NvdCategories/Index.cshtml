@model IReadOnlyList<NvdCategory>
@{
    ViewData["Title"] = "Quản lý danh mục";
}
<div class="page-heading">
    <div><span class="eyebrow">Bài thực hành CRUD</span><h1>Danh mục sản phẩm</h1><p>Quản lý danh mục bằng Entity Framework Core.</p></div>
    <a class="btn btn-primary" asp-action="Create">+ Thêm danh mục</a>
</div>
<form method="get" class="toolbar">
    <label><span>Tìm kiếm</span><input type="search" name="search" value="@ViewBag.Search" placeholder="Tên danh mục..." /></label>
    <label><span>Trạng thái</span><select name="status"><option value="">Tất cả</option><option value="true">Đang hiển thị</option><option value="false">Đang ẩn</option></select></label>
    <button class="btn btn-primary" type="submit">Lọc</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a>
</form>
<div class="table-card">
    <table>
        <thead><tr><th>Tên danh mục</th><th>Trạng thái</th><th>Ngày tạo</th><th>Sản phẩm</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.NvdName</strong></td>
                <td><span class="badge @(item.NvdStatus ? "badge-on" : "badge-off")">@(item.NvdStatus ? "Hiển thị" : "Đang ẩn")</span></td>
                <td>@item.NvdCreatedDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td>@item.NvdProducts.Count</td>
                <td class="actions">
                    <a class="btn btn-small btn-outline" asp-action="Details" asp-route-id="@item.NvdCategoryId">Xem</a>
                    <a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.NvdCategoryId">Sửa</a>
                    <a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.NvdCategoryId">Xóa</a>
                    <form asp-action="ToggleStatus" asp-route-id="@item.NvdCategoryId" method="post"><button class="btn btn-small btn-ghost" type="submit">Đổi trạng thái</button></form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
