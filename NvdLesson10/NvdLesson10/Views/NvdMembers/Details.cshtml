@model NvdMember
@{
    ViewData["Title"] = Model.NvdFullName;
}

<section class="detail-page">
    <div class="container narrow-container">
        <div class="breadcrumb-line"><a asp-action="Index">Thành viên</a><span>/</span><strong>Chi tiết #@Model.Id</strong></div>
        <div class="profile-panel panel">
            <div class="profile-cover"><span class="database-tag">dbo.NvdMember</span></div>
            <div class="profile-content">
                <div class="profile-heading">
                    <span class="profile-avatar">@Model.NvdFullName.Substring(0, 1).ToUpperInvariant()</span>
                    <div><span class="status-pill @(Model.NvdStatus ? "active" : "inactive")"><i></i>@(Model.NvdStatus ? "Đang hoạt động" : "Tạm khóa")</span><h1>@Model.NvdFullName</h1><p>@@@Model.NvdUserName · ID @Model.Id</p></div>
                </div>
                <dl class="detail-grid">
                    <div><dt>Email</dt><dd>@Model.NvdEmail</dd></div>
                    <div><dt>Số điện thoại</dt><dd>@(Model.NvdPhone ?? "Chưa cập nhật")</dd></div>
                    <div><dt>Mật khẩu</dt><dd><span class="secure-value">•••••••• · Đã băm</span></dd></div>
                    <div><dt>Ngày tạo</dt><dd>@Model.NvdCreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
                </dl>
                <div class="detail-actions"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa</a><a class="btn btn-ghost" asp-action="Index">Quay lại</a><a class="btn btn-danger-soft" asp-action="Delete" asp-route-id="@Model.Id">Xóa</a></div>
            </div>
        </div>
        <div class="query-note"><span>SQL</span><div><strong>Truy vấn bởi Entity Framework Core</strong><p><code>FirstOrDefaultAsync(member =&gt; member.Id == id)</code></p></div></div>
    </div>
</section>
