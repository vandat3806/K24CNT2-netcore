@model NvdMemberEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa thành viên";
}

<section class="form-page">
    <div class="container narrow-container">
        <div class="breadcrumb-line"><a asp-action="Index">Thành viên</a><span>/</span><a asp-action="Details" asp-route-id="@Model.Id">Chi tiết</a><span>/</span><strong>Chỉnh sửa</strong></div>
        <div class="form-heading"><div><span class="eyebrow dark">UPDATE · ID @Model.Id</span><h1>Chỉnh sửa bản ghi</h1><p>EF Core theo dõi entity và chỉ lưu các giá trị đã thay đổi.</p></div><span class="form-badge">UPDATE</span></div>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-panel panel" novalidate>
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-section-title"><span>01</span><div><h2>Thông tin thành viên</h2><p>Kiểm tra trùng username và email trước khi cập nhật.</p></div></div>
            <partial name="_MemberFields" model="Model" />
            <div class="form-divider"></div>
            <div class="form-section-title"><span>02</span><div><h2>Đổi mật khẩu</h2><p>Để trống nếu muốn giữ nguyên mật khẩu hiện tại.</p></div></div>
            <div class="field-group full-width">
                <label asp-for="NewPassword"></label>
                <div class="password-field"><input asp-for="NewPassword" autocomplete="new-password" data-password-input /><button type="button" data-toggle-password>Hiện</button></div>
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="form-footer"><a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Hủy</a><button class="btn btn-primary" type="submit">Lưu thay đổi</button></div>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
