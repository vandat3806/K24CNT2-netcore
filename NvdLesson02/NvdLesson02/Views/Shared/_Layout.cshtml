<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Lesson02 Controller in ASP.NET Core MVC - Nguyen van dat - 2410900021" />
    <title>@ViewData["Title"] - NVD Lesson02</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NvdLesson02.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">NVD</span> Lesson02
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="NvdProduct" asp-action="NvdIndex">Sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="NvdProduct" asp-action="NvdDataTransfer">Truyền dữ liệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="NvdActionResult" asp-action="Index">ActionResult</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="NvdRoute" asp-action="Index">Routes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-student" asp-controller="Home" asp-action="About">Sinh viên</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container footer-content">
            <span>Lesson02 - Controller in ASP.NET Core MVC</span>
            <span>Nguyen van dat · 2410900021</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
