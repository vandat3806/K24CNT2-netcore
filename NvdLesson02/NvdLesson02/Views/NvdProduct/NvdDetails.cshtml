@model NvdProduct
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="page-heading">
    <span class="eyebrow eyebrow-dark">ACTION NHẬN ROUTE PARAMETER</span>
    <h1>Chi tiết sản phẩm</h1>
    <p>Thử cả <code>/NvdProduct/NvdDetails/@Model.Id</code> và <code>/san-pham/@Model.Id</code>.</p>
</div>

<article class="detail-card">
    <div class="product-icon">@Model.Id</div>
    <div class="detail-body">
        <span class="code-pill">@Model.ProductCode</span>
        <h2>@Model.ProductName</h2>
        <div class="detail-grid">
            <div><span>Năm sản xuất</span><strong>@Model.YearRelease</strong></div>
            <div><span>Đơn giá</span><strong>@Model.Price.ToString("N0") đ</strong></div>
        </div>
    </div>
</article>

<div class="mt-4 d-flex gap-2 flex-wrap">
    <a class="btn btn-primary" asp-action="NvdIndex">Về danh sách</a>
    <a class="btn btn-outline-primary" href="/san-pham/@Model.Id">Mở bằng custom route</a>
</div>
