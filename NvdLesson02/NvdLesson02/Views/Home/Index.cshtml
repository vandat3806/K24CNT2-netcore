@model NvdStudentInfo
@{
    ViewData["Title"] = "Lesson02 - Controller";
}

<section class="hero-section">
    <div class="hero-copy">
        <span class="eyebrow">ASP.NET CORE MVC · LESSON 02</span>
        <h1>Controller, Action, View<br />và Routing</h1>
        <p class="hero-lead">
            Project thực hành tổng hợp cách tạo Controller, Action, View, truyền dữ liệu,
            trả về các loại ActionResult và cấu hình Routes.
        </p>
        <div class="hero-actions">
            <a class="btn btn-light btn-lg" asp-controller="NvdProduct" asp-action="NvdDataTransfer">Xem 4 cách truyền dữ liệu</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="NvdRoute" asp-action="Index">Khám phá Routes</a>
        </div>
    </div>
    <div class="hero-student-card">
        <span class="student-label">BÀI LÀM CỦA SINH VIÊN</span>
        <div class="avatar">NVD</div>
        <h2>@Model.FullName</h2>
        <p class="student-id">MSV: @Model.StudentId</p>
        <div class="student-meta">
            <span>@Model.ClassName</span>
            <span>.NET 8.0</span>
        </div>
    </div>
</section>

<section class="content-section">
    <div class="section-heading">
        <span class="eyebrow eyebrow-dark">NỘI DUNG ĐÃ HOÀN THÀNH</span>
        <h2>Toàn bộ nội dung Lesson02</h2>
        <p>Mỗi mục đều có mã nguồn và trang chạy minh họa trực tiếp.</p>
    </div>

    <div class="topic-grid">
        <article class="topic-card">
            <span class="topic-number">01</span>
            <h3>Controller</h3>
            <p>Các lớp Controller kế thừa <code>Controller</code>, nhận request và điều phối xử lý.</p>
        </article>
        <article class="topic-card">
            <span class="topic-number">02</span>
            <h3>Actions</h3>
            <p>Nhiều Action public nhận tham số từ URL, route value và query string.</p>
        </article>
        <article class="topic-card">
            <span class="topic-number">03</span>
            <h3>Views</h3>
            <p>Razor Views theo đúng quy ước <code>Views/Controller/Action.cshtml</code>.</p>
        </article>
        <article class="topic-card topic-card-featured">
            <span class="topic-number">04</span>
            <h3>Truyền dữ liệu</h3>
            <p>Đủ ViewBag, ViewData, TempData và strongly typed Model.</p>
            <a asp-controller="NvdProduct" asp-action="NvdDataTransfer">Mở ví dụ →</a>
        </article>
        <article class="topic-card">
            <span class="topic-number">05</span>
            <h3>ActionResult</h3>
            <p>View, Content, JSON, Redirect, File, StatusCode, NotFound, PartialView và Empty.</p>
            <a asp-controller="NvdActionResult" asp-action="Index">Mở ví dụ →</a>
        </article>
        <article class="topic-card">
            <span class="topic-number">06</span>
            <h3>Routes</h3>
            <p>Conventional route, attribute route, tham số, constraint và named route.</p>
            <a asp-controller="NvdRoute" asp-action="Index">Mở ví dụ →</a>
        </article>
    </div>
</section>
