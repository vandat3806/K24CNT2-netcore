@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    IReadOnlyList<Category> categories = ViewBag.Categories as IReadOnlyList<Category> ?? Array.Empty<Category>();
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
    string selectedCategoryName = ViewBag.SelectedCategoryName as string ?? "Tất cả sản phẩm";
}

<section class="page-hero product-hero">
    <div class="container page-hero-grid">
        <div>
            <span class="eyebrow">BÀI TẬP TỰ LÀM · PRODUCTCONTROLLER</span>
            <h1>Sản phẩm công nghệ</h1>
            <p>Chọn danh mục để lọc sản phẩm hoặc mở trang chi tiết theo id trên URL.</p>
        </div>
        <div class="hero-stat">
            <strong>@Model.Count</strong>
            <span>sản phẩm đang hiển thị</span>
        </div>
    </div>
</section>

<section class="container content-section">
    <div class="catalog-layout">
        <aside class="category-panel">
            <span class="eyebrow dark">DANH MỤC</span>
            <h2>Lọc sản phẩm</h2>
            <nav class="category-list" aria-label="Danh mục sản phẩm">
                <a class="@(selectedCategoryId is null ? "active" : string.Empty)" asp-route="product">
                    <span>Tất cả</span><b>10</b>
                </a>
                @foreach (Category category in categories)
                {
                    <a class="@(selectedCategoryId == category.Id ? "active" : string.Empty)"
                       asp-route="product-category"
                       asp-route-categoryId="@category.Id">
                        <span>@category.Name</span>
                        <b>@(category.Id switch { 1 => 3, 2 => 2, 3 => 3, _ => 2 })</b>
                    </a>
                }
            </nav>
            <div class="route-note">
                <span>Route đang dùng</span>
                <code>@(selectedCategoryId is null ? "/san-pham" : $"/san-pham/danh-muc/{selectedCategoryId}")</code>
            </div>
        </aside>

        <div class="catalog-content">
            <div class="catalog-heading">
                <div>
                    <span class="eyebrow dark">@selectedCategoryName.ToUpperInvariant()</span>
                    <h2>@selectedCategoryName</h2>
                </div>
                <span class="result-count">@Model.Count kết quả</span>
            </div>

            <div class="product-grid">
                @foreach (Product product in Model)
                {
                    int discount = product.Price > 0
                        ? (int)Math.Round((1 - product.SalePrice / product.Price) * 100)
                        : 0;

                    <article class="product-card">
                        <div class="product-image-wrap">
                            <img src="@product.Image" alt="@product.Name" />
                            <span class="discount-badge">-@discount%</span>
                            <span class="@(product.Status ? "availability in-stock" : "availability coming")">
                                @(product.Status ? "Còn hàng" : "Sắp về")
                            </span>
                        </div>
                        <div class="product-card-body">
                            <span class="product-code">NVD-P@product.Id.ToString("D3")</span>
                            <h3>@product.Name</h3>
                            <p>@product.Description</p>
                            <div class="price-row">
                                <strong>@product.SalePrice.ToString("N0") đ</strong>
                                <del>@product.Price.ToString("N0") đ</del>
                            </div>
                            <a class="btn btn-dark w-100"
                               asp-route="product-detail"
                               asp-route-id="@product.Id">Xem chi tiết</a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </div>
</section>
