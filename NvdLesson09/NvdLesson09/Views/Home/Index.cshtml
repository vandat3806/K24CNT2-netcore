@model LessonOverviewViewModel
@{
    ViewData["Title"] = "Data Annotation";
}

<section class="hero-section">
    <div class="container hero-grid">
        <div class="hero-copy">
            <span class="eyebrow">LESSON 09 · ASP.NET CORE MVC</span>
            <h1>Dữ liệu đúng ngay từ <span>điểm nhập.</span></h1>
            <p>
                Thực hành Data Annotation và custom validation qua bài toán quản lý sản phẩm:
                rõ quy tắc, báo lỗi đúng trường và giữ dữ liệu nhất quán.
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="NvdProduct" asp-action="Index">Xem danh sách sản phẩm</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="NvdProduct" asp-action="Create">Thử form validation</a>
            </div>
            <div class="student-signature">
                <span>NVD</span>
                <div>
                    <strong>Nguyễn Văn Đạt</strong>
                    <small>2410900021 · K24CNT2</small>
                </div>
            </div>
        </div>

        <div class="validation-console" aria-label="Minh họa quy tắc validation">
            <div class="console-head">
                <div><span></span><span></span><span></span></div>
                <small>NvdProduct.cs</small>
            </div>
            <div class="code-lines">
                <p><i>01</i><code>[Required]</code></p>
                <p><i>02</i><code>[StringLength(150, MinimumLength = 6)]</code></p>
                <p><i>03</i><code>[Range(100000, 1000000000)]</code></p>
                <p class="highlight"><i>04</i><code>[DiscountPrice(nameof(Price), 10)]</code></p>
                <p><i>05</i><code>[NoForbiddenWords("admin", "spam", "fake")]</code></p>
            </div>
            <div class="console-result">
                <span>✓</span>
                <div>
                    <strong>ModelState.IsValid</strong>
                    <small>Chỉ xử lý khi toàn bộ quy tắc hợp lệ</small>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="dashboard-strip">
    <div class="container stat-grid">
        <article>
            <span class="stat-symbol green">P</span>
            <div><strong>@Model.ProductCount</strong><small>Sản phẩm mẫu</small></div>
        </article>
        <article>
            <span class="stat-symbol amber">C</span>
            <div><strong>@Model.CategoryCount</strong><small>Danh mục</small></div>
        </article>
        <article>
            <span class="stat-symbol blue">%</span>
            <div><strong>@Model.SaleProductCount</strong><small>Sản phẩm giảm giá</small></div>
        </article>
        <article>
            <span class="stat-symbol rose">4</span>
            <div><strong>Custom</strong><small>Validation attributes</small></div>
        </article>
    </div>
</section>

<section class="lesson-section">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow dark">NỘI DUNG THỰC HÀNH</span>
                <h2>Từ annotation đến trải nghiệm form hoàn chỉnh</h2>
            </div>
            <p>Mỗi quy tắc được gắn sát dữ liệu, tái sử dụng được và hiển thị lỗi ngay tại trường nhập.</p>
        </div>

        <div class="topic-grid">
            <article class="topic-card featured">
                <span class="topic-number">01</span>
                <h3>Built-in annotations</h3>
                <p>Required, StringLength, Range, DataType và Display kiểm tra các điều kiện phổ biến.</p>
                <code>[StringLength(150, MinimumLength = 6)]</code>
            </article>
            <article class="topic-card">
                <span class="topic-number">02</span>
                <h3>Custom validation</h3>
                <p>Kế thừa ValidationAttribute để kiểm tra giá chéo thuộc tính và nội dung mô tả.</p>
                <code>protected override IsValid(...)</code>
            </article>
            <article class="topic-card">
                <span class="topic-number">03</span>
                <h3>Upload an toàn</h3>
                <p>Giới hạn định dạng, dung lượng và đổi tên ảnh trước khi lưu vào thư mục riêng.</p>
                <code>wwwroot/products</code>
            </article>
        </div>
    </div>
</section>

<section class="latest-section">
    <div class="container latest-grid">
        <div>
            <span class="eyebrow dark">DỮ LIỆU MINH HỌA</span>
            <h2>Sản phẩm vừa cập nhật</h2>
            <p>Kho dữ liệu trong bộ nhớ giúp tập trung vào Model, ModelState và luồng CRUD của bài học.</p>
            <a class="text-link" asp-controller="NvdProduct" asp-action="Index">Mở toàn bộ danh sách <span>→</span></a>
        </div>
        <div class="latest-list">
            @foreach (var product in Model.LatestProducts)
            {
                <a class="latest-item" asp-controller="NvdProduct" asp-action="Details" asp-route-id="@product.Id">
                    <img src="@product.Image" alt="Ảnh @product.Name" />
                    <span>
                        <small>@product.Category.Name</small>
                        <strong>@product.Name</strong>
                    </span>
                    <b>@product.SalePrice.ToString("N0") ₫</b>
                </a>
            }
        </div>
    </div>
</section>
