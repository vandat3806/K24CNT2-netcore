@model NvdProductEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<section class="form-page">
    <div class="container narrow-container">
        <div class="breadcrumb-line">
            <a asp-action="Index">Sản phẩm</a><span>/</span><a asp-action="Details" asp-route-id="@Model.Id">Chi tiết</a><span>/</span><strong>Chỉnh sửa</strong>
        </div>
        <div class="form-heading">
            <div>
                <span class="eyebrow dark">EDIT · ID @Model.Id</span>
                <h1>Chỉnh sửa sản phẩm</h1>
                <p>Ảnh hiện tại được giữ nguyên nếu không chọn tệp thay thế.</p>
            </div>
            <span class="form-badge">Server validation</span>
        </div>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-panel panel" novalidate>
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-section-title">
                <span>01</span>
                <div><h2>Thông tin sản phẩm</h2><p>Cập nhật dữ liệu và kiểm tra lại toàn bộ annotation.</p></div>
            </div>

            <partial name="_ProductFields" model="Model" />

            <div class="form-divider"></div>
            <div class="form-section-title">
                <span>02</span>
                <div><h2>Ảnh sản phẩm</h2><p>Ảnh mới là tùy chọn, định dạng hợp lệ và tối đa 2 MB.</p></div>
            </div>
            <div class="edit-image-grid">
                <div class="current-image">
                    <img src="@Model.ExistingImage" alt="Ảnh hiện tại của @Model.Name" />
                    <small>Ảnh hiện tại</small>
                </div>
                <div>
                    <div class="upload-zone compact">
                        <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" data-image-input />
                        <div class="upload-preview" data-image-preview>
                            <span aria-hidden="true">↥</span>
                            <strong>Chọn ảnh thay thế</strong>
                            <small>Để trống nếu muốn giữ ảnh cũ</small>
                        </div>
                    </div>
                    <span asp-validation-for="ImageFile" class="file-error"></span>
                </div>
            </div>

            <div class="form-footer">
                <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Hủy</a>
                <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
