@model NvdProduct
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<section class="delete-page">
    <div class="container delete-container">
        <div class="delete-card panel">
            <span class="delete-symbol" aria-hidden="true">!</span>
            <span class="eyebrow danger">DELETE · CONFIRMATION</span>
            <h1>Xóa sản phẩm?</h1>
            <p>Thao tác sẽ xóa sản phẩm khỏi kho dữ liệu hiện tại. Ảnh đã tải lên được giữ lại để tránh xóa nhầm tệp.</p>

            <div class="delete-product">
                <img src="@Model.Image" alt="Ảnh @Model.Name" />
                <div>
                    <small>@Model.Category.Name · #NVD-@Model.Id.ToString("D3")</small>
                    <strong>@Model.Name</strong>
                    <span>@Model.SalePrice.ToString("N0") ₫</span>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="delete-actions">
                <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Không, quay lại</a>
                <button class="btn btn-danger" type="submit">Xác nhận xóa</button>
            </form>
        </div>
    </div>
</section>
